# Backend legado (Node/Express + MySQL). O app publicado usa Supabase;
# estas variáveis são necessárias apenas para `npm start` / `npm run dev`.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=controle_pagamentos

# Use uma chave aleatória de 32+ caracteres (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais
JWT_EXPIRES_IN=7d

# Gere o par com: npm run vapid
# A pública vai para public/js/config.js; a privada fica só no servidor/Edge Functions.
VAPID_SUBJECT=mailto:seu-email@exemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Alertas diários (node-cron)
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=America/Sao_Paulo
ALERTAS_RODAR_AO_INICIAR=false
