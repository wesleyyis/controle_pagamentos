# Segredos das Edge Functions. Copie para supabase/.env, preencha e envie com:
#   npx supabase secrets set --env-file supabase/.env
# (supabase/.env já está no .gitignore — nunca suba este arquivo para o GitHub)

# Mesmas chaves do seu .env antigo (ou gere novas: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use um e-mail real: alguns serviços de push (Apple) rejeitam contato inválido
VAPID_SUBJECT=mailto:seu-email-real@exemplo.com

# Segredo que autoriza o agendador a chamar a função "alertas".
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
